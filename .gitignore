# Environment (.env.example is the tracked template; .envrc and .dotenv are
# the tracked direnv shims that load .env)
.env
.env.*
!.env.example

# OpenTofu / Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
**/tfplan
plans/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
dist/
build/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Lambda build artifacts
**/handler.zip
**/lambda.zip
**/lambda-*.zip

# Lambda pip dependencies (installed at build time)
modules/db-users/lambda/pg8000/
modules/db-users/lambda/scramp/
modules/db-users/lambda/asn1crypto/
modules/db-users/lambda/dateutil/
modules/db-users/lambda/*.dist-info/
modules/db-users/lambda/six.py
modules/db-on-shared-rds/lambda/pg8000/
modules/db-on-shared-rds/lambda/scramp/
modules/db-on-shared-rds/lambda/asn1crypto/
modules/db-on-shared-rds/lambda/dateutil/
modules/db-on-shared-rds/lambda/*.dist-info/
modules/db-on-shared-rds/lambda/six.py
**/lambda/.deps-installed

# Shared Lambda code, copied into each bundle at apply time by
# null_resource.lambda_dependencies. The tracked copy is
# modules/lambda-shared/db_common.py -- edit that, never these.
# Listed by exact path, never a glob: index.py must stay tracked.
modules/db-users/lambda/db_common.py
modules/db-on-shared-rds/lambda/db_common.py

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code (the skills directory and settings.json are tracked)
.claude/*
!.claude/skills/
!.claude/settings.json

# OS
.DS_Store
Thumbs.db

# Project-specific local files (notes, results, custom docs)
local/

# detect-secrets bootstrap temp file (see SECURITY.md Practice #8)
.secrets.baseline.tmp
