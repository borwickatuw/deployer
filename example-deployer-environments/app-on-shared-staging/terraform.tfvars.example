# MyApp Staging Environment (Shared Infrastructure)
# DO NOT commit this file to version control (contains sensitive data)

# ------------------------------------------------------------------------------
# App Identity
# ------------------------------------------------------------------------------

app_name    = "myapp"
environment = "staging"

# ------------------------------------------------------------------------------
# Database Credentials
# ------------------------------------------------------------------------------

db_username = "myapp_admin"
db_password = "CHANGE-ME-generate-a-secure-password"  # Generate with: openssl rand -base64 24

# ------------------------------------------------------------------------------
# Domain Configuration
# ------------------------------------------------------------------------------

domain_name     = "myapp.staging.example.com"
route53_zone_id = "Z1234567890ABC"  # Your Route53 zone ID

# ------------------------------------------------------------------------------
# ALB Routing
# ------------------------------------------------------------------------------

# Priority must be unique across all apps in the shared environment
# Convention: first app = 100, second app = 200, etc.
listener_rule_priority = 100

# ------------------------------------------------------------------------------
# Service Configuration
# ------------------------------------------------------------------------------

services = {
  web = {
    cpu               = 256
    memory            = 512
    replicas          = 1
    load_balanced     = true
    port              = 8000
    health_check_path = "/health/"
  }
}

# ------------------------------------------------------------------------------
# Auto-Scaling
# ------------------------------------------------------------------------------

# Auto-scaling disabled in staging
scaling = {}
