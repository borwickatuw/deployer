# {{app_name | title}} {{env_type | title}} Environment
#
# This instantiates the infrastructure for a standalone staging environment.
# Application deployments are handled separately by the deploy.py script.
#
# Usage:
#   cd ~/code/deployer-environments/{{env_name}}
#   ../bin/tofu.sh init
#   ../bin/tofu.sh plan
#   ../bin/tofu.sh apply

terraform {
  required_version = ">= 1.6.0"

  # Uncomment and configure for remote state (recommended for team environments)
  # backend "s3" {
  #   bucket  = "deployer-terraform-state-123456789012"  # Update with your account ID
  #   key     = "{{env_name}}/terraform.tfstate"
  #   region  = "us-west-2"
  #   encrypt = true
  # }
}

# ------------------------------------------------------------------------------
# Data Sources
# ------------------------------------------------------------------------------

data "aws_caller_identity" "current" {}

# ------------------------------------------------------------------------------
# Health Check Presets
# Staging: optimized for fast deployment feedback
# ------------------------------------------------------------------------------

locals {
  health_check = {
    interval             = 10  # 10s between checks
    timeout              = 5   # 5s timeout
    healthy_threshold    = 2   # 2 successes = healthy
    unhealthy_threshold  = 3   # 3 failures = unhealthy
    deregistration_delay = 15  # 15s drain time
    grace_period         = 60  # 60s before ECS starts health checking
  }
}

# ------------------------------------------------------------------------------
# Variables
# ------------------------------------------------------------------------------

variable "project_name" {
  type        = string
  description = "Name of the project (used for resource naming)"
}

variable "db_username" {
  type      = string
  sensitive = true
}

variable "db_password" {
  type        = string
  sensitive   = true
  description = "Database password (min 16 chars, no placeholder values)"

  validation {
    condition     = length(var.db_password) >= 16
    error_message = "Database password must be at least 16 characters."
  }

  validation {
    condition     = !can(regex("^(password|changeme|example|CHANGE)", lower(var.db_password)))
    error_message = "Database password cannot be a placeholder value."
  }
}

variable "domain_name" {
  type        = string
  description = "Domain name for the staging environment (e.g., {{app_name}}-staging.example.com)"
}

variable "route53_zone_id" {
  type        = string
  description = "Route 53 hosted zone ID for automatic certificate creation"
  default     = null
}

# Service configuration - sizing that varies by environment
variable "services" {
  type = map(object({
    cpu               = number
    memory            = number
    replicas          = number
    load_balanced     = bool
    port              = optional(number)
    health_check_path = optional(string, "/")
    path_pattern      = optional(string)
  }))
  description = "Service sizing configuration (cpu, memory, replicas)"
}

# Auto-scaling configuration - typically only used in production
variable "scaling" {
  type = map(object({
    min_replicas = number
    max_replicas = number
    cpu_target   = optional(number, 70)
  }))
  default     = {}
  description = "Auto-scaling policies per service"
}

# Health check defaults
variable "health_check" {
  type = object({
    interval            = optional(number, 30)
    timeout             = optional(number, 10)
    healthy_threshold   = optional(number, 2)
    unhealthy_threshold = optional(number, 5)
    grace_period        = optional(number, 60)
  })
  default     = {}
  description = "Global health check defaults"
}

# ECR repositories to create
variable "ecr_repository_names" {
  type        = list(string)
  default     = []
  description = "List of ECR repository names to create (e.g., ['web', 'worker'])"
}

# WAF Configuration
variable "waf_enabled" {
  type        = bool
  description = "Enable AWS WAF for the ALB"
  default     = true
}

variable "waf_rate_limit_requests" {
  type        = number
  description = "Maximum requests per IP in a 5-minute window"
  default     = 2000
}

variable "waf_geo_block_countries" {
  type        = list(string)
  description = "Country codes to block (e.g., ['RU', 'CN'])"
  default     = []
}

variable "waf_ip_allowlist" {
  type        = list(string)
  description = "CIDR blocks that bypass WAF (e.g., office IPs)"
  default     = []
}

variable "waf_rule_action_override" {
  type        = string
  description = "Set to 'count' to test rules without blocking"
  default     = "none"
}

# ------------------------------------------------------------------------------
# Infrastructure Module
# ------------------------------------------------------------------------------

module "infrastructure" {
  source = "../"

  project_name = var.project_name
  environment  = "{{env_type}}"
  aws_region   = "us-west-2"

  # VPC
  vpc_cidr           = "10.0.0.0/16"
  availability_zones = ["us-west-2a", "us-west-2b"]

  # Database
  db_instance_class    = "db.t3.micro"
  db_allocated_storage = 20
  db_name              = var.project_name
  db_username          = var.db_username
  db_password          = var.db_password

  # Cache
  cache_enabled   = true
  cache_node_type = "cache.t3.micro"

  # Storage
  s3_buckets = {
    "media" = {
      versioning           = false
      public               = false
      cors_allowed_origins = ["https://${var.domain_name}"]
    }
  }

  # HTTPS and Authentication
  domain_name     = var.domain_name
  route53_zone_id = var.route53_zone_id

  # Enable Cognito authentication for staging
  cognito_auth_enabled = true

  # Health check settings from staging preset
  default_health_check_path = "/health/"
  health_check_interval     = local.health_check.interval
  health_check_timeout      = local.health_check.timeout
  healthy_threshold         = local.health_check.healthy_threshold
  unhealthy_threshold       = local.health_check.unhealthy_threshold
  deregistration_delay      = local.health_check.deregistration_delay

  # ECR repositories
  ecr_repository_names = var.ecr_repository_names

  # WAF configuration
  waf_enabled              = var.waf_enabled
  waf_rate_limit_requests  = var.waf_rate_limit_requests
  waf_geo_block_countries  = var.waf_geo_block_countries
  waf_ip_allowlist         = var.waf_ip_allowlist
  waf_rule_action_override = var.waf_rule_action_override

  # IAM permissions boundary (required for role creation)
  iam_permissions_boundary = "arn:aws:iam::${data.aws_caller_identity.current.account_id}:policy/deployer-ecs-role-boundary"
}

# ------------------------------------------------------------------------------
# CI/CD Role (optional)
#
# Uncomment to create a GitHub Actions CI deploy role for this project.
# Requires: modules/ci in bootstrap (creates OIDC provider + S3 bucket).
# See docs/CI-CD.md for setup instructions.
# ------------------------------------------------------------------------------

