# {{app_name | title}} {{env_type | title}} - Configuration
# DO NOT commit this file to version control (may contain sensitive data)
#
# Copy to terraform.tfvars and fill in values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Generate a secure password:
#   openssl rand -base64 24

# ------------------------------------------------------------------------------
# Project Settings
# ------------------------------------------------------------------------------

project_name = "{{app_name}}"

# ------------------------------------------------------------------------------
# Database Credentials (sensitive)
# ------------------------------------------------------------------------------

db_username = "{{app_name}}_admin"
db_password = "CHANGE_THIS_PASSWORD"  # Generate with: openssl rand -base64 24

# ------------------------------------------------------------------------------
# Domain Configuration
# ------------------------------------------------------------------------------

domain_name     = "{{domain}}"
route53_zone_id = "Z1234567890ABC"  # Your Route53 zone ID

# ------------------------------------------------------------------------------
# Service Configuration
# ------------------------------------------------------------------------------

{{services_block}}

# ------------------------------------------------------------------------------
# Auto-Scaling (disabled in staging)
# ------------------------------------------------------------------------------

{{scaling_block}}

# ------------------------------------------------------------------------------
# ECR Repositories
# ------------------------------------------------------------------------------

ecr_repository_names = ["web"]

# ------------------------------------------------------------------------------
# CI/CD Configuration (optional)
# Uncomment if you enabled the ci_role module in main.tf.
# See docs/CI-CD.md for setup instructions.
# ------------------------------------------------------------------------------

# github_repo = "myorg/myapp"  # GitHub org/repo for OIDC deployment

# ------------------------------------------------------------------------------
# WAF Configuration
# ------------------------------------------------------------------------------

waf_enabled              = true   # Enable AWS WAF for the ALB
waf_rate_limit_requests  = 2000   # Max requests per IP per 5 minutes
waf_geo_block_countries  = []     # e.g., ["RU", "CN", "KP"]
waf_ip_allowlist         = []     # CIDRs that bypass WAF (e.g., office IPs)
waf_rule_action_override = "none" # Set to "count" to test without blocking
